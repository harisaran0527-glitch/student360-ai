# ============================================================
# Student360 AI — Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.
# NEVER commit .env to git.
# ============================================================

# 1. DATABASE — Supabase PostgreSQL
# Production Runtime (Netlify Serverless) — Transaction Pooler (Port 6543):
DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"

# Direct Database URL (Port 5432) — Used for DDL/migrations:
DIRECT_URL="postgresql://postgres:<PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres?sslmode=require"

# 2. APPLICATION
NODE_ENV="development"
APP_URL="http://localhost:3000"
# Production example: APP_URL="https://student360.netlify.app"

# 3. AUTHENTICATION
# Must be at least 32 random characters — generate with: openssl rand -hex 32
JWT_SECRET="change_me_to_32_plus_char_random_string"

# 4. SUPABASE STORAGE
# CLOUD_STORAGE_PROVIDER: LOCAL (dev) | SUPABASE (production)
CLOUD_STORAGE_PROVIDER="LOCAL"

# From: Supabase Dashboard → Project Settings → API → Project URL
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"

# From: Supabase Dashboard → Project Settings → API → service_role (secret)
# WARNING: This is a secret key. Never expose it in the browser or commit to git.
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# The name of the storage bucket you created in Supabase
SUPABASE_BUCKET="student360-assets"

# 5. SMTP EMAIL (Optional — emails silently skipped if not configured)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="Student360 AI <your-email@gmail.com>"

# 6. CRON SECURITY
# Random secret to protect scheduled cron endpoints
CRON_SECRET="change_me_to_random_secret"
