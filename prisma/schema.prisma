generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                  String                  @id @default(uuid())
  email               String                  @unique
  passwordHash        String
  fullName            String
  role                String                  @default("STUDENT")
  avatarUrl           String?
  isActive            Boolean                 @default(true)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  studentProfile      StudentProfile?
  assignedCourses     Course[]                @relation("FacultyCourses")
  attendanceSessions  AttendanceSession[]      @relation("FacultySessions")
  postedOpportunities InternshipOpportunity[]  @relation("PostedOpportunities")
  postedDrives        PlacementDrive[]        @relation("PostedPlacementDrives")
  announcements       Announcement[]          @relation("PostedAnnouncements")
  auditLogs           AuditLog[]
  posts               StudentPost[]
  comments            PostComment[]
  notifications       Notification[]
}

model Department {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  hodName   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sections Section[]
  courses  Course[]
  students StudentProfile[]
  batches  Batch[]
}

model Batch {
  id                     String   @id @default(uuid())
  name                   String   @unique
  admissionYear          Int      @default(2026)
  expectedGraduationYear Int      @default(2030)
  departmentId           String?
  courseTitle            String?
  totalSemesters         Int      @default(8)
  currentSemester        Int      @default(1)
  status                 String   @default("ACTIVE")
  isCurrent              Boolean  @default(false)
  isArchived             Boolean  @default(false)
  archivedAt             DateTime?
  archivedReason         String?
  archivedBy             String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  department             Department? @relation(fields: [departmentId], references: [id])
  sections               Section[]
  students               StudentProfile[]
  semesterConfigs        SemesterConfig[]
  placementDrives        PlacementDrive[]
}

model Section {
  id           String     @id @default(uuid())
  name         String     
  departmentId String
  batchId      String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  batch        Batch      @relation(fields: [batchId], references: [id], onDelete: Cascade)
  students     StudentProfile[]
  sessions     AttendanceSession[]

  @@unique([departmentId, batchId, name])
}

model AcademicYear {
  id        String   @id @default(uuid())
  yearCode  String   @unique
  name      String?
  startDate String?  
  endDate   String?  
  status    String   @default("ACTIVE")
  isCurrent Boolean  @default(false)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  admittedStudents StudentProfile[] @relation("AdmissionAcademicYear")
}

model SemesterConfig {
  id                           String   @id @default(uuid())
  batchId                      String
  semesterNumber               Int
  academicYearCode             String
  startDate                    String?
  endDate                      String?
  status                       String   @default("UPCOMING")
  internshipRequired           Boolean  @default(false)
  internshipRequirement        String   @default("OPTIONAL")
  submissionDeadline           String?
  minDurationWeeks             Int      @default(4)
  allowedModes                 String   @default("ONLINE,OFFLINE,HYBRID")
  requireFacultyApproval       Boolean  @default(true)
  requireCompletionCertificate Boolean  @default(true)
  requireReport                Boolean  @default(true)
  minAttendancePercentage      Float    @default(75.0)
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  batch                        Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([batchId, semesterNumber])
}

model Course {
  id               String     @id @default(uuid())
  code             String     @unique
  title            String
  credits          Int        @default(3)
  semester         Int
  departmentId     String
  facultyId        String?
  academicYearCode String     @default("2025-2029")
  subjectType      String     @default("CORE")
  isActive         Boolean    @default(true)
  isArchived       Boolean    @default(false)
  archivedAt       DateTime?
  archivedReason   String?
  archivedBy       String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  department       Department @relation(fields: [departmentId], references: [id])
  faculty          User?      @relation("FacultyCourses", fields: [facultyId], references: [id])
  attendances      Attendance[]
  sessions         AttendanceSession[]
  academicRecords  AcademicRecord[]
}

model AttendanceSession {
  id               String       @id @default(uuid())
  academicYearCode String       @default("2025-2029")
  semester         Int          @default(1)
  courseId         String
  sectionId        String?
  date             String       
  period           Int          @default(1)
  facultyId        String?
  totalPresent     Int          @default(0)
  totalAbsent      Int          @default(0)
  totalOd          Int          @default(0)
  totalInternship  Int          @default(0)
  isArchived       Boolean      @default(false)
  archivedAt       DateTime?
  archivedReason   String?
  archivedBy       String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  course           Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  section          Section?     @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  faculty          User?        @relation("FacultySessions", fields: [facultyId], references: [id])
  attendances      Attendance[]
  corrections      AttendanceCorrection[]

  @@unique([courseId, sectionId, date, period])
}

model StudentProfile {
  id                   String        @id @default(uuid())
  userId               String        @unique
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  registerNo           String        @unique
  rollNo               String
  admissionNo          String        @unique
  
  fullName             String
  gender               String        @default("Male")
  dob                  String        
  bloodGroup           String?
  email                String        @unique
  personalEmail        String?
  institutionalEmail   String?       @unique
  phone                String
  aadharNo             String?
  profilePic           String?
  
  fatherName           String
  motherName           String
  guardianPhone        String?
  emergencyPhone       String
  addressLine1         String
  addressLine2         String?
  city                 String
  state                String        @default("Tamil Nadu")
  pincode              String
  
  departmentId         String
  batchId              String?
  sectionId            String?
  academicYear         String        @default("2025-2029")
  currentSemester      Int           @default(1)
  entryType            String        @default("REGULAR")
  admissionQuota       String?
  residenceType        String        @default("DAY_SCHOLAR")
  admissionDate        String
  academicStatus       String        @default("PURSUING")
  
  graduationDate       String?
  graduationAcademicYear String?
  finalCgpa            Float?
  
  cgpa                 Float         @default(0.0)
  attendancePercentage Float         @default(100.0)
  
  isArchived           Boolean       @default(false)
  archivedAt           DateTime?
  archiveReason        String?
  archivedBy           String?
  restoredAt           DateTime?
  restoredBy           String?

  religion             String?
  community            String?
  motherTongue         String?
  degreeLevel          String?
  reservation75        String?
  firstGraduate        String?

  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  department           Department    @relation(fields: [departmentId], references: [id])
  batch                Batch?        @relation(fields: [batchId], references: [id])
  section              Section?      @relation(fields: [sectionId], references: [id])
  admissionAcademicYearId String?
  admissionAcademicYear AcademicYear? @relation("AdmissionAcademicYear", fields: [admissionAcademicYearId], references: [id])

  attendances          Attendance[]
  semesterHistory      StudentSemesterHistory[]
  odRecords            ODRecord[]
  corrections          AttendanceCorrection[]
  academicRecords      AcademicRecord[]
  internships          Internship[]
  certificates         Certificate[]
  achievements         Achievement[]
  projects             Project[]
  skills               Skill[]
  posts                StudentPost[]
  complianceReports    StudentComplianceReport[]
  opportunityApps      StudentOpportunityApplication[]
  placementRecords     PlacementRecord[]
  portfolioSettings    PortfolioSettings?
  alumniRecord         AlumniRecord?
  careerPreference     StudentCareerPreference?
  riskSnapshots        StudentRiskSnapshot[]
  aiInsightSnapshots   AIInsightSnapshot[]
  recommendationHistory RecommendationHistory[]
  busRecord            BusRecord?

  @@index([registerNo])
  @@index([rollNo])
  @@index([departmentId])
  @@index([batchId])
  @@index([admissionQuota])
  @@index([academicStatus])
  @@index([academicYear])
  @@index([fullName])
}

model BusRecord {
  id            String         @id @default(uuid())
  studentId     String         @unique
  resident      String
  busNo         String
  route         String
  boardingPoint String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  student       StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Attendance {
  id               String             @id @default(uuid())
  studentId        String
  sessionId        String?
  courseId         String
  academicYearCode String             @default("2025-2029")
  semester         Int                @default(1)
  date             String             
  session          String             @default("FN")
  status           String             @default("PRESENT")
  facultyId        String?
  remarks          String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  student          StudentProfile     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  attendanceSession AttendanceSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  course           Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId, date, session])
}

model ODRecord {
  id           String         @id @default(uuid())
  studentId    String
  reason       String
  category     String         @default("Hackathon")
  fromDate     String         
  toDate       String         
  documentUrl  String?
  status       String         @default("PENDING")
  approvedBy   String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model AttendancePolicy {
  id                      String   @id @default(uuid())
  minAttendancePercentage Float    @default(75.0)
  countOdAsPresent        Boolean  @default(true)
  countInternshipAsPresent Boolean  @default(true)
  countMedicalAsPresent   Boolean  @default(false)
  allowLateCount          Boolean  @default(true)
  updatedAt               DateTime @updatedAt
}

model AttendanceCorrection {
  id           String             @id @default(uuid())
  attendanceId String?
  sessionId    String?
  studentId    String
  oldStatus    String
  newStatus    String
  reason       String
  changedBy    String
  createdAt    DateTime           @default(now())

  student      StudentProfile     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  session      AttendanceSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
}

model AcademicCalendar {
  id               String   @id @default(uuid())
  date             String   @unique
  dayType          String   @default("WORKING_DAY")
  description      String?
  academicYearCode String   @default("2025-2029")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model StudentSemesterHistory {
  id                   String        @id @default(uuid())
  studentId            String
  semester             Int
  academicYearCode     String
  sgpa                 Float         @default(0.0)
  cgpa                 Float         @default(0.0)
  attendancePercentage Float         @default(100.0)
  result               String        @default("PASS")
  completedAt          DateTime      @default(now())

  student              StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, semester])
}

model AcademicRecord {
  id            String         @id @default(uuid())
  studentId     String
  courseId      String
  semester      Int
  internalMarks Float          @default(0.0)
  externalMarks Float          @default(0.0)
  totalMarks    Float          @default(0.0)
  grade         String         @default("O")
  credits       Int            @default(3)
  result        String         @default("PASS")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  student       StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course        Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model Internship {
  id                   String           @id @default(uuid())
  studentId            String
  academicYearCode     String           @default("2025-2029")
  batchId              String?
  departmentId         String?
  semester             Int              @default(1)

  companyName          String
  companyWebsite       String?
  industry             String           @default("Software & IT")
  domain               String           @default("Software Engineering")
  role                 String
  mode                 String           @default("ONLINE")
  location             String?

  startDate            String
  endDate              String
  durationWeeks        Int              @default(8)

  mentorName           String?
  mentorDesignation    String?
  mentorEmail          String?
  mentorContact        String?

  stipendType          String           @default("PAID")
  stipendAmount        String?

  applicationProofUrl  String?
  offerLetterUrl       String?
  joiningLetterUrl     String?
  nocUrl               String?
  permissionLetterUrl  String?
  weeklyReportUrl      String?
  finalReportUrl       String?
  certificateUrl       String?

  status               String           @default("SUBMITTED_FOR_APPROVAL")

  nocNumber            String?          @unique
  nocGeneratedAt       DateTime?
  nocGeneratedBy       String?

  workSummary          String?
  toolsUsed            String?
  skillsLearned        String?
  projectSummary       String?
  wouldRecommend       String?          @default("YES")

  isArchived           Boolean          @default(false)
  archivedAt           DateTime?
  archivedReason       String?
  archivedBy           String?

  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  student              StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  certificates         Certificate[]
  posts                StudentPost[]

  @@index([studentId, academicYearCode])
  @@index([status])
}

model InternshipOpportunity {
  id              String   @id @default(uuid())
  companyName     String
  role            String
  domain          String
  description     String
  eligibility     String?
  requiredSkills  String?
  location        String
  mode            String   @default("HYBRID")
  startDate       String
  duration        String
  deadline        String
  availableSlots  Int      @default(5)
  applicationLink String?
  postedBy        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User?    @relation("PostedOpportunities", fields: [postedBy], references: [id])
  applications    StudentOpportunityApplication[]
}

model StudentOpportunityApplication {
  id            String                @id @default(uuid())
  studentId     String
  opportunityId String
  status        String                @default("APPLIED")
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  student       StudentProfile        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  opportunity   InternshipOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@unique([studentId, opportunityId])
}

model Certificate {
  id                 String             @id @default(uuid())
  studentId          String
  title              String
  category           String             @default("Certification")
  issuingBody        String
  issueDate          String
  startDate          String?
  endDate            String?
  academicYearCode   String             @default("2025-2029")
  semester           Int                @default(1)
  mode               String             @default("ONLINE")
  location           String?
  certificateNo     String?
  documentUrl        String
  fileName           String?
  mimeType           String?
  fileSize           Int?
  uploadedAt         DateTime?
  externalLink       String?
  skillsGained       String?
  projectId          String?
  internshipId       String?
  verificationStatus String             @default("PENDING")
  verifiedBy         String?
  verifiedAt         DateTime?
  reviewerNotes      String?
  rejectionReason    String?
  isArchived         Boolean            @default(false)
  archivedAt         DateTime?
  archivedReason     String?
  archivedBy         String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  student            StudentProfile     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  project            Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  internship         Internship?        @relation(fields: [internshipId], references: [id], onDelete: SetNull)
  posts              StudentPost[]

  @@index([studentId, academicYearCode])
  @@index([verificationStatus])
}

model Achievement {
  id                 String             @id @default(uuid())
  studentId          String
  title              String
  category           String             @default("Hackathon")
  eventName          String
  organizer          String
  position           String             @default("Participant")
  date               String
  academicYearCode   String             @default("2025-2029")
  semester           Int                @default(1)
  documentUrl        String?
  verificationStatus String             @default("PENDING")
  verifiedBy         String?
  verifiedAt         DateTime?
  reviewerNotes      String?
  rejectionReason    String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  student            StudentProfile     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  posts              StudentPost[]
}

model Project {
  id                 String             @id @default(uuid())
  studentId          String
  title              String
  description        String
  detailedDescription String?
  projectType        String             @default("MINI_PROJECT") // MINI_PROJECT, COURSE_PROJECT, HACKATHON_PROJECT, INTERNSHIP_PROJECT, RESEARCH_PROJECT, FINAL_YEAR_PROJECT, PERSONAL_PROJECT, OTHER
  academicYearCode   String             @default("2025-2029")
  semester           Int                @default(1)
  category           String             @default("Web Development")
  techStack          String
  toolsUsed          String?
  languages          String?
  domain             String?            @default("Software Engineering")
  facultyMentor      String?
  teamMembers        String?            // JSON String of team members [{ name, registerNo, role }]
  problemStatement   String?
  objectives         String?
  githubUrl          String?
  demoUrl            String?
  liveUrl            String?
  presentationUrl    String?
  documentUrl        String?
  screenshots        String?
  startDate          String?
  completionDate     String?
  status             String             @default("COMPLETED") // PLANNED, ONGOING, COMPLETED, VERIFIED, NEEDS_CHANGES, REJECTED, ARCHIVED
  verifiedBy         String?
  verifiedAt         DateTime?
  reviewerNotes      String?
  guideName          String?
  guideRating        Float?
  isArchived         Boolean            @default(false)
  archivedAt         DateTime?
  archivedReason     String?
  archivedBy         String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  student            StudentProfile     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  certificates       Certificate[]
  posts              StudentPost[]

  @@index([studentId, academicYearCode])
  @@index([status])
}

model Skill {
  id                 String             @id @default(uuid())
  studentId          String
  name               String
  category           String             @default("Programming") // Programming, AI/ML, Data Science, Web Development, Mobile Development, Cloud, Database, Cyber Security, Design, Communication, Leadership, Other
  proficiency        String             @default("Intermediate")
  level              String             @default("Intermediate") // Beginner, Intermediate, Advanced
  evidenceType       String             @default("SELF_REPORTED") // SELF_REPORTED, CERTIFICATE, PROJECT, INTERNSHIP, FACULTY_VERIFIED
  evidenceRecordId   String?
  verified           Boolean            @default(false)
  createdAt          DateTime           @default(now())

  student            StudentProfile     @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model PlacementDrive {
  id                 String             @id @default(uuid())
  companyName        String
  driveName          String
  role               String
  description        String
  eligibility        String?
  minCgpa            Float              @default(6.0)
  allowedDepartments String?
  batchId            String?
  requiredSkills     String?
  location           String             @default("Bengaluru")
  packageCtc         Float              @default(6.5) // LPA
  deadline           String
  driveDate          String
  applicationLink    String?
  status             String             @default("ACTIVE") // UPCOMING, ACTIVE, COMPLETED, CLOSED
  postedBy           String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user               User?              @relation("PostedPlacementDrives", fields: [postedBy], references: [id])
  batch              Batch?             @relation(fields: [batchId], references: [id])
  records            PlacementRecord[]
}

model PlacementRecord {
  id                 String             @id @default(uuid())
  studentId          String
  placementDriveId   String?
  companyName        String
  jobTitle           String
  packageLpa         Float              @default(6.0)
  offerDate          String
  status             String             @default("APPLIED") // ELIGIBLE, APPLIED, SHORTLISTED, APTITUDE, TECHNICAL_ROUND, HR_ROUND, SELECTED, REJECTED, OFFER_RECEIVED, JOINED
  resumeUrl          String?
  applicationProofUrl String?
  selectionLetterUrl String?
  offerLetterUrl     String?
  joiningLetterUrl   String?
  updatedBy          String?
  isArchived         Boolean            @default(false)
  archivedAt         DateTime?
  archivedReason     String?
  archivedBy         String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  student            StudentProfile     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  drive              PlacementDrive?    @relation(fields: [placementDriveId], references: [id], onDelete: SetNull)
}

model PortfolioSettings {
  id                   String         @id @default(uuid())
  studentId            String         @unique
  profileVisibility    String         @default("PORTFOLIO_VISIBLE") // PRIVATE, INSTITUTION_ONLY, PORTFOLIO_VISIBLE
  showSkills           Boolean        @default(true)
  showProjects         Boolean        @default(true)
  showInternships      Boolean        @default(true)
  showCertificates     Boolean        @default(true)
  showAchievements     Boolean        @default(true)
  showPlacementStatus  Boolean        @default(false)
  updatedAt            DateTime       @updatedAt

  student              StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model AlumniRecord {
  id                String         @id @default(uuid())
  studentId         String         @unique
  graduationYear    Int
  currentCompany    String?
  currentRole       String?
  higherStudiesInst String?
  linkedinUrl       String?
  country           String         @default("India")
  isArchived        Boolean        @default(false)
  archivedAt        DateTime?
  archivedReason    String?
  archivedBy        String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  student           StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model StudentPost {
  id              String        @id @default(uuid())
  userId          String
  studentId       String?
  title           String
  content         String
  category        String        @default("General")
  mediaUrl        String?
  certificateId   String?
  achievementId   String?
  internshipId    String?
  projectId       String?
  skills          String?
  status          String        @default("PENDING_REVIEW")
  moderatedBy     String?
  moderatedAt     DateTime?
  moderationNotes String?
  likesCount      Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  student         StudentProfile? @relation(fields: [studentId], references: [id], onDelete: Cascade)
  certificate     Certificate?  @relation(fields: [certificateId], references: [id], onDelete: SetNull)
  achievement     Achievement?  @relation(fields: [achievementId], references: [id], onDelete: SetNull)
  internship      Internship?   @relation(fields: [internshipId], references: [id], onDelete: SetNull)
  project         Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  comments        PostComment[]
}

model PostComment {
  id        String      @id @default(uuid())
  postId    String
  userId    String
  content   String
  createdAt DateTime    @default(now())

  post      StudentPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id                 String    @id @default(uuid())
  userId             String
  studentId          String?
  type               String    @default("INFO")
  title              String
  message            String
  priority           String    @default("NORMAL")
  relatedModule      String?   
  relatedRecordId    String?
  status             String    @default("UNREAD")
  read               Boolean   @default(false)
  readAt             DateTime?
  emailRequired      Boolean   @default(false)
  emailStatus        String    @default("NOT_REQUIRED")
  emailSentAt        DateTime?
  emailFailureReason String?
  deduplicationKey   String?   @unique
  isArchived         Boolean   @default(false)
  archivedAt         DateTime?
  archivedReason     String?
  archivedBy         String?
  createdAt          DateTime  @default(now())

  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model StudentComplianceReport {
  id                  String         @id @default(uuid())
  studentId           String
  academicYear        String         @default("2025-2029")
  semester            Int            @default(1)
  reportType          String         @default("INTERNSHIP_NON_COMPLETION")
  generatedDate       String         
  status              String         @default("OPEN")
  summary             String
  missingRequirements String         
  notificationId      String?
  emailDeliveryStatus String         @default("PENDING")
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  student             StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model NotificationSettings {
  id                      String   @id @default(uuid())
  enableEmailNotifications Boolean  @default(true)
  enableAttendanceAlerts  Boolean  @default(true)
  enableInternshipAlerts  Boolean  @default(true)
  enableCertificateAlerts Boolean  @default(true)
  enableAcademicAlerts    Boolean  @default(true)
  enableAnnouncements     Boolean  @default(true)
  internshipDeadlineDays  Int      @default(7)
  attendanceThreshold     Float    @default(75.0)
  cooldownDays            Int      @default(3)
  facultyCopy             Boolean  @default(false)
  hodCopy                 Boolean  @default(false)
  updatedAt               DateTime @updatedAt
}

model Announcement {
  id                 String    @id @default(uuid())
  title              String
  message            String
  audienceType       String    @default("ALL")
  targetDepartmentId String?
  targetBatchId      String?
  targetSectionId    String?
  priority           String    @default("NORMAL")
  startDate          String?
  expiryDate         String?
  postedBy           String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user               User?     @relation("PostedAnnouncements", fields: [postedBy], references: [id])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  userEmail  String?
  userRole   String?
  action     String   
  entityType String   
  entityId   String?
  details    String   
  ipAddress  String?
  createdAt  DateTime @default(now())

  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model ArchiveRecord {
  id                 String   @id @default(uuid())
  studentRegisterNo  String
  studentName        String
  batchName          String
  departmentCode     String
  archivedReason     String
  fullBackupSnapshot String   
  archivedBy         String
  createdAt          DateTime @default(now())
}

model CareerRoleProfile {
  id                      String                     @id @default(uuid())
  roleName                String                     @unique
  description             String
  coreSkills              String                     
  recommendedSkills       String                     
  optionalSkills          String                     
  suggestedProjectDomains String                     
  suggestedInternshipDomains String                  
  isActive                Boolean                    @default(true)
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt

  studentPreferences      StudentCareerPreference[]
}

model StudentCareerPreference {
  id           String            @id @default(uuid())
  studentId    String            @unique
  targetRoleId String
  interests    String?
  updatedAt    DateTime          @updatedAt

  student      StudentProfile    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  targetRole   CareerRoleProfile @relation(fields: [targetRoleId], references: [id], onDelete: Cascade)
}

model StudentRiskSnapshot {
  id              String         @id @default(uuid())
  studentId       String
  academicYear    String         @default("2025-2029")
  semester        Int            @default(1)
  attentionLevel  String         @default("LOW_ATTENTION")
  factors         String         
  inputsUsed      String         
  recommendation  String         
  engineVersion   String         @default("Student Support Engine v1.0 — Rule Based")
  generatedAt     DateTime       @default(now())

  student         StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, academicYear, semester])
}

model AIInsightSnapshot {
  id            String          @id @default(uuid())
  studentId     String?
  academicYear  String          @default("2025-2029")
  semester      Int             @default(1)
  insightType   String          
  result        String          
  explanation   String          
  inputsUsed    String          
  engineVersion String
  generatedAt   DateTime        @default(now())

  student       StudentProfile? @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, insightType])
}

model RecommendationHistory {
  id                 String         @id @default(uuid())
  studentId          String
  recommendationType String         
  result             String         
  explanation        String
  engineVersion      String
  generatedAt        DateTime       @default(now())

  student            StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

model SavedReportPreset {
  id             String   @id @default(uuid())
  name           String
  description    String?
  reportCategory String
  reportType     String
  filters        String   
  createdBy      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  lastUsedAt     DateTime @default(now())

  @@index([createdBy])
}

model ScheduledReportConfig {
  id         String    @id @default(uuid())
  reportType String
  frequency  String    @default("WEEKLY")
  recipients String    
  filters    String    
  enabled    Boolean   @default(true)
  lastRunAt  DateTime?
  nextRunAt  DateTime?
  createdBy  String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}


